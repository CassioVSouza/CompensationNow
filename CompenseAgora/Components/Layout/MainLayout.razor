@inherits LayoutComponentBase

@* MudBlazor's global services (theme, popovers, dialogs, snackbars) need an
   interactive circuit. Scoping @rendermode to just these provider components
   -- rather than to MainLayout itself -- keeps every other page's render mode
   untouched, which matters because the static-SSR auth pages (Login/Register,
   the NavMenu logout form) rely on MainLayout staying render-mode-neutral. *@
<MudThemeProvider Theme="CompenseAgoraTheme.Default" @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div id="top" class="top-row px-4">
            <AuthorizeView Context="authState">
                <Authorized>
                    <span>Olá, @authState.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="app-footer px-4">
            <span>&copy; @DateTime.Now.Year Compense Agora. Todos os direitos reservados.</span>
            <a href="#top" class="app-footer-back-to-top">Voltar ao topo ↑</a>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
