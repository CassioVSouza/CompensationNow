@page "/login"
@using System.Security.Claims
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.Auth.Commands.Login
@using MediatR
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

<EditForm Model="Input" FormName="login" OnSubmit="HandleLoginAsync" method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" type="email" @bind-Value="Input.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText class="form-control" type="password" @bind-Value="Input.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Log in</button>
</EditForm>

<p class="mt-3">
    Don't have an account? <a href="/register">Create one</a>
</p>

@code {
    private string? _errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    public InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;

        try
        {
            var result = await Mediator.Send(new LoginCommand(Input.Email, Input.Password));

            var claims = new List<Claim>
            {
                new(ClaimTypes.NameIdentifier, result.Codigo.ToString()),
                new(ClaimTypes.Email, result.Email),
                new(ClaimTypes.GivenName, result.Nome),
                new(ClaimTypes.Surname, result.Sobrenome),
                new("cognito_sub", result.CognitoSub),
            };

            var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            var principal = new ClaimsPrincipal(identity);

            await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);

            NavigationManager.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl, forceLoad: true);
        }
        catch (AuthException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
    }

    public class InputModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
