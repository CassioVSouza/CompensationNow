@page "/register"
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.Auth.Commands.Register
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Cadastro</PageTitle>

<h1>Criar conta</h1>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

<p class="text-muted">
    Campos marcados com <span class="text-danger" aria-hidden="true">*</span> são obrigatórios.
    Todo o resto é opcional e pode ser deixado em branco.
</p>

<EditForm Model="Input" FormName="register" OnSubmit="HandleRegisterAsync" method="post">
    <fieldset class="mb-4">
        <legend class="h5">Dados de acesso</legend>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="nome">Nome <span class="text-danger" aria-hidden="true">*</span></label>
                <InputText id="nome" class="form-control" @bind-Value="Input.Nome" required autocomplete="given-name" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="sobrenome">Sobrenome <span class="text-danger" aria-hidden="true">*</span></label>
                <InputText id="sobrenome" class="form-control" @bind-Value="Input.Sobrenome" required autocomplete="family-name" />
            </div>
            <div class="col-md-12">
                <label class="form-label" for="email">E-mail <span class="text-danger" aria-hidden="true">*</span></label>
                <InputText id="email" class="form-control" type="email" @bind-Value="Input.Email" required autocomplete="email"
                           aria-describedby="email-ajuda" />
                <div id="email-ajuda" class="form-text">Enviaremos um código para este e-mail para confirmar sua conta.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="senha">Senha <span class="text-danger" aria-hidden="true">*</span></label>
                <InputText id="senha" class="form-control" type="password" @bind-Value="Input.Password" required
                           minlength="8" autocomplete="new-password" aria-describedby="senha-ajuda" />
                <div id="senha-ajuda" class="form-text">
                    Mínimo de 8 caracteres, com letra maiúscula, letra minúscula, número e caractere especial.
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="confirmar-senha">Confirmar senha <span class="text-danger" aria-hidden="true">*</span></label>
                <InputText id="confirmar-senha" class="form-control" type="password" @bind-Value="Input.ConfirmPassword" required
                           autocomplete="new-password" />
            </div>
        </div>
    </fieldset>

    <fieldset class="mb-3">
        <legend class="h5">
            Informações adicionais <span class="badge text-bg-secondary align-middle fw-normal">Opcional</span>
        </legend>
        <p class="form-text mt-0 mb-3">
            Não são necessárias para usar a plataforma. Preencha só se quiser completar seu perfil.
        </p>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="celular">Celular <span class="text-muted">(opcional)</span></label>
                <InputText id="celular" class="form-control" type="tel" @bind-Value="Input.Celular" autocomplete="tel" />
            </div>
            <div class="col-md-6"></div>
            <div class="col-md-8">
                <label class="form-label" for="endereco">Endereço <span class="text-muted">(opcional)</span></label>
                <InputText id="endereco" class="form-control" @bind-Value="Input.Endereco" autocomplete="address-line1" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="numero">Número <span class="text-muted">(opcional)</span></label>
                <InputText id="numero" class="form-control" @bind-Value="Input.Numero" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="bairro">Bairro <span class="text-muted">(opcional)</span></label>
                <InputText id="bairro" class="form-control" @bind-Value="Input.Bairro" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="cidade">Cidade <span class="text-muted">(opcional)</span></label>
                <InputText id="cidade" class="form-control" @bind-Value="Input.Cidade" autocomplete="address-level2" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="estado">Estado <span class="text-muted">(opcional)</span></label>
                <InputText id="estado" class="form-control" @bind-Value="Input.Estado" autocomplete="address-level1" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="pais">País <span class="text-muted">(opcional)</span></label>
                <InputText id="pais" class="form-control" @bind-Value="Input.Pais" autocomplete="country-name" />
            </div>
        </div>
    </fieldset>

    <button type="submit" class="btn btn-primary">Criar conta</button>
</EditForm>

<p class="mt-3">
    Já tem uma conta? <a href="/login">Entrar</a>
</p>

@code {
    private string? _errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    public InputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;

        if (Input.Password != Input.ConfirmPassword)
        {
            _errorMessage = "As senhas não coincidem.";
            return;
        }

        try
        {
            var result = await Mediator.Send(new RegisterCommand(
                Input.Nome,
                Input.Sobrenome,
                Input.Email,
                Input.Password,
                Input.Endereco,
                Input.Bairro,
                Input.Numero,
                Input.Cidade,
                Input.Estado,
                Input.Pais,
                Input.Celular));

            var destination = result.RequiresConfirmation
                ? $"/confirm-email?email={Uri.EscapeDataString(Input.Email)}"
                : "/login";

            NavigationManager.NavigateTo(destination, forceLoad: true);
        }
        catch (AuthException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
    }

    public class InputModel
    {
        public string Nome { get; set; } = string.Empty;
        public string Sobrenome { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public string Endereco { get; set; } = string.Empty;
        public string Bairro { get; set; } = string.Empty;
        public string Numero { get; set; } = string.Empty;
        public string Cidade { get; set; } = string.Empty;
        public string Estado { get; set; } = string.Empty;
        public string Pais { get; set; } = string.Empty;
        public string Celular { get; set; } = string.Empty;
    }
}
