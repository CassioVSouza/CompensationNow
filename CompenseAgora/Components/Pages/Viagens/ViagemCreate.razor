@page "/viagens/nova"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using CompenseAgora.Features.Combustiveis
@using CompenseAgora.Features.Combustiveis.Queries.GetCombustiveis
@using CompenseAgora.Features.Frotas
@using CompenseAgora.Features.Frotas.Queries.GetFrotas
@using CompenseAgora.Features.Viagens.Commands.CreateViagem
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Nova viagem</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Nova viagem</MudText>

@if (_frotas is null || _combustiveis is null)
{
    <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando dados do formulário…</span>
    </div>
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 800px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <ViagemFormFields Model="_input" Frotas="_frotas" Combustiveis="_combustiveis" OnChanged="HandleFieldChangedAsync" />

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/viagens" Disabled="@_isSaving">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    private ViagemInputModel _input = new();
    private List<FrotaDto>? _frotas;
    private List<CombustivelDto>? _combustiveis;
    private string? _errorMessage;
    private bool _isSaving;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _frotas = await Mediator.Send(new GetFrotasQuery());
        _combustiveis = await Mediator.Send(new GetCombustiveisQuery());
    }

    private Task HandleFieldChangedAsync()
    {
        // Clear a stale error once the person starts correcting the form.
        if (_errorMessage is not null)
        {
            _errorMessage = null;
        }

        return Task.CompletedTask;
    }

    private async Task HandleSaveAsync()
    {
        _errorMessage = ValidateForMode(_input);
        if (_errorMessage is not null)
        {
            return;
        }

        var authState = await AuthenticationStateTask!;
        var codigoPessoa = int.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        var command = new CreateViagemCommand(
            codigoPessoa,
            _input.TipoRegistro == TipoRegistroViagem.PorCombustivel ? null : _input.CodigoFrota,
            _input.TipoRegistro == TipoRegistroViagem.PorCombustivel ? _input.CodigoCombustivel : null,
            _input.DataReferencia,
            _input.TipoRegistro == TipoRegistroViagem.PorDistancia ? 0 : _input.Consumo,
            _input.TipoRegistro == TipoRegistroViagem.PorCombustivel ? 0 : _input.AnoFrota,
            _input.TipoRegistro == TipoRegistroViagem.PorDistancia ? _input.DistanciaKM : 0);

        _isSaving = true;
        try
        {
            await Mediator.Send(command);
            Snackbar.Add("Viagem criada com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/viagens");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar a viagem agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    internal static string? ValidateForMode(ViagemInputModel input)
    {
        switch (input.TipoRegistro)
        {
            case TipoRegistroViagem.PorDistancia when input.CodigoFrota is null or <= 0:
                return "Selecione um veículo.";
            case TipoRegistroViagem.PorDistancia when input.DistanciaKM <= 0:
                return "Informe a distância percorrida.";
            case TipoRegistroViagem.PorCombustivel when input.Consumo <= 0 || input.CodigoCombustivel <= 0:
                return "Informe o consumo de combustível e selecione um combustível.";
            case TipoRegistroViagem.PorTipoEAno when input.CodigoFrota is null or <= 0:
                return "Selecione um veículo.";
            case TipoRegistroViagem.PorTipoEAno when input.AnoFrota <= 0 || input.Consumo <= 0:
                return "Informe o ano do veículo e o consumo de combustível.";
            default:
                return null;
        }
    }
}
