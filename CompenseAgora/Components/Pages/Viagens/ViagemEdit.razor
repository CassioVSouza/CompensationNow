@page "/viagens/{Codigo:int}/editar"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.Combustiveis
@using CompenseAgora.Features.Combustiveis.Queries.GetCombustiveis
@using CompenseAgora.Features.Frotas
@using CompenseAgora.Features.Frotas.Queries.GetFrotas
@using CompenseAgora.Features.Viagens.Commands.UpdateViagem
@using CompenseAgora.Features.Viagens.Queries.GetViagemById
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Editar viagem</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Editar viagem</MudText>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
        Esta viagem não foi encontrada. Ela pode já ter sido excluída.
    </MudAlert>
    <MudButton Class="mt-3" Variant="Variant.Text" Href="/viagens">Voltar para a lista</MudButton>
}
else if (_frotas is null || _combustiveis is null)
{
    <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando viagem…</span>
    </div>
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 800px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <ViagemFormFields Model="_input" Frotas="_frotas" Combustiveis="_combustiveis" OnChanged="HandleFieldChangedAsync" />

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/viagens" Disabled="@_isSaving">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private ViagemInputModel _input = new();
    private List<FrotaDto>? _frotas;
    private List<CombustivelDto>? _combustiveis;
    private string? _errorMessage;
    private bool _notFound;
    private bool _isSaving;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var codigoPessoa = int.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        var viagem = await Mediator.Send(new GetViagemByIdQuery(Codigo));
        if (viagem is null || viagem.CodigoPessoa != codigoPessoa)
        {
            _notFound = true;
            return;
        }

        _input = new ViagemInputModel
        {
            CodigoFrota = viagem.CodigoFrota,
            DataReferencia = viagem.DataReferencia,
            TipoRegistro = InferTipoRegistro(viagem),
            AnoFrota = viagem.AnoFrota,
            Consumo = viagem.Consumo,
            DistanciaKM = viagem.DistanciaKM,
            CodigoCombustivel = viagem.CodigoCombustivel ?? 0,
        };

        _frotas = await Mediator.Send(new GetFrotasQuery());
        _combustiveis = await Mediator.Send(new GetCombustiveisQuery());
    }

    private Task HandleFieldChangedAsync()
    {
        if (_errorMessage is not null)
        {
            _errorMessage = null;
        }

        return Task.CompletedTask;
    }

    private async Task HandleSaveAsync()
    {
        _errorMessage = ViagemCreate.ValidateForMode(_input);
        if (_errorMessage is not null)
        {
            return;
        }

        var command = new UpdateViagemCommand(
            Codigo,
            _input.TipoRegistro == TipoRegistroViagem.PorCombustivel ? null : _input.CodigoFrota,
            _input.TipoRegistro == TipoRegistroViagem.PorCombustivel ? _input.CodigoCombustivel : null,
            _input.DataReferencia,
            _input.TipoRegistro == TipoRegistroViagem.PorDistancia ? 0 : _input.Consumo,
            _input.TipoRegistro == TipoRegistroViagem.PorCombustivel ? 0 : _input.AnoFrota,
            _input.TipoRegistro == TipoRegistroViagem.PorDistancia ? _input.DistanciaKM : 0);

        _isSaving = true;
        try
        {
            await Mediator.Send(command);
            Snackbar.Add("Viagem atualizada com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/viagens");
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar as alterações agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static TipoRegistroViagem InferTipoRegistro(Features.Viagens.ViagemDto viagem)
    {
        if (viagem.CodigoCombustivel is not null)
        {
            return TipoRegistroViagem.PorCombustivel;
        }

        return viagem.DistanciaKM > 0 ? TipoRegistroViagem.PorDistancia : TipoRegistroViagem.PorTipoEAno;
    }
}
