@page "/viagens/{Codigo:int}/excluir"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.Viagens.Commands.DeleteViagem
@using CompenseAgora.Features.Viagens.Queries.GetViagemById
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<PageTitle>Delete trip</PageTitle>

<h1>Delete trip</h1>

@if (_viagem is null)
{
    @if (!_notFound)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <p>This trip could not be found.</p>
    }
}
else
{
    <p>Are you sure you want to delete this trip? This action cannot be undone.</p>

    <dl class="row">
        <dt class="col-sm-3">Reference date</dt>
        <dd class="col-sm-9">@_viagem.DataReferencia.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Vehicle</dt>
        <dd class="col-sm-9">@_viagem.FrotaNome</dd>
        <dt class="col-sm-3">Fuel</dt>
        <dd class="col-sm-9">@(_viagem.CombustivelNome ?? "-")</dd>
    </dl>

    <button class="btn btn-danger" @onclick="HandleDeleteAsync">Delete</button>
    <a class="btn btn-link" href="/viagens">Cancel</a>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private Features.Viagens.ViagemDto? _viagem;
    private bool _notFound;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var codigoPessoa = int.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        var viagem = await Mediator.Send(new GetViagemByIdQuery(Codigo));
        if (viagem is null || viagem.CodigoPessoa != codigoPessoa)
        {
            _notFound = true;
            return;
        }

        _viagem = viagem;
    }

    private async Task HandleDeleteAsync()
    {
        try
        {
            await Mediator.Send(new DeleteViagemCommand(Codigo));
            NavigationManager.NavigateTo("/viagens");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _viagem = null;
        }
    }
}
