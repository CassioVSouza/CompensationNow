@using CompenseAgora.Features.Frotas
@using CompenseAgora.Features.Combustiveis

<MudGrid>
    @if (Model.TipoRegistro != TipoRegistroViagem.PorCombustivel)
    {
        <MudItem xs="12" sm="6">
            <MudSelect T="int?" Label="Veículo" @bind-Value="Model.CodigoFrota" @bind-Value:after="NotifyChangedAsync"
                       Variant="Variant.Outlined" Placeholder="Selecione um veículo..."
                       HelperText="O veículo cadastrado ao qual esta viagem pertence.">
                @foreach (var frota in Frotas)
                {
                    <MudSelectItem T="int?" Value="@((int?)frota.Codigo)">@frota.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    }
    <MudItem xs="12" sm="6">
        <MudDatePicker Label="Data de referência" @bind-Date="_dataReferencia" @bind-Date:after="NotifyChangedAsync"
                       Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"
                       HelperText="Data em que a viagem ocorreu." />
    </MudItem>
</MudGrid>

<MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Tipo de registro</MudText>
<MudRadioGroup T="TipoRegistroViagem" @bind-Value="Model.TipoRegistro" @bind-Value:after="NotifyChangedAsync">
    <MudRadio T="TipoRegistroViagem" Value="TipoRegistroViagem.PorDistancia" Color="Color.Primary">Por distância</MudRadio>
    <MudRadio T="TipoRegistroViagem" Value="TipoRegistroViagem.PorCombustivel" Color="Color.Primary">Por combustível</MudRadio>
    <MudRadio T="TipoRegistroViagem" Value="TipoRegistroViagem.PorTipoEAno" Color="Color.Primary">Por tipo e ano</MudRadio>
</MudRadioGroup>

@if (Model.TipoRegistro == TipoRegistroViagem.PorDistancia)
{
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Culture="@CulturaBrasileira.PtBr" Label="Ano do veículo" @bind-Value="Model.AnoFrota" @bind-Value:after="NotifyChangedAsync"
                              Variant="Variant.Outlined" Min="0"
                              HelperText="Ano de fabricação do veículo (opcional)." />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Distância (km)" @bind-Value="Model.DistanciaKM" @bind-Value:after="NotifyChangedAsync"
                              Variant="Variant.Outlined" Min="0"
                              HelperText="Distância total percorrida, em quilômetros." />
        </MudItem>
    </MudGrid>
}
else if (Model.TipoRegistro == TipoRegistroViagem.PorCombustivel)
{
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="6">
            <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Consumo de combustível" @bind-Value="Model.Consumo" @bind-Value:after="NotifyChangedAsync"
                              Variant="Variant.Outlined" Min="0"
                              HelperText="Quantidade de combustível consumida, em litros." />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="int" Label="Combustível" @bind-Value="Model.CodigoCombustivel" @bind-Value:after="NotifyChangedAsync"
                       Variant="Variant.Outlined" Placeholder="Selecione um combustível..."
                       HelperText="Não é necessário selecionar um veículo neste modo.">
                @foreach (var combustivel in Combustiveis)
                {
                    <MudSelectItem T="int" Value="@combustivel.Codigo">@combustivel.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
}
else
{
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Culture="@CulturaBrasileira.PtBr" Label="Ano do veículo" @bind-Value="Model.AnoFrota" @bind-Value:after="NotifyChangedAsync"
                              Variant="Variant.Outlined" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Consumo de combustível" @bind-Value="Model.Consumo" @bind-Value:after="NotifyChangedAsync"
                              Variant="Variant.Outlined" Min="0" HelperText="Em litros." />
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter, EditorRequired]
    public ViagemInputModel Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<FrotaDto> Frotas { get; set; } = [];

    [Parameter, EditorRequired]
    public List<CombustivelDto> Combustiveis { get; set; } = [];

    /// <summary>Raised after any field changes, so the parent page can re-run business validation live.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private DateTime? _dataReferencia;

    protected override void OnParametersSet()
    {
        _dataReferencia = Model.DataReferencia.ToDateTime(TimeOnly.MinValue);
    }

    private async Task NotifyChangedAsync()
    {
        Model.DataReferencia = DateOnly.FromDateTime(_dataReferencia ?? DateTime.Now);

        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync();
        }
    }
}
