@page "/admin/combustiveis/{Codigo:int}/editar"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Entities
@using CompenseAgora.Features.Combustiveis
@using CompenseAgora.Features.Combustiveis.Commands.UpdateCombustivel
@using CompenseAgora.Features.Combustiveis.Queries.GetCombustivelById
@using CompenseAgora.Features.Combustiveis.Queries.GetTodosCombustiveis
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Editar combustível</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Editar combustível</MudText>

@if (!_loaded)
{
    @if (!_notFound)
    {
        <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <span>Carregando combustível…</span>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Este combustível não foi encontrado. Ele pode já ter sido excluído.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" Href="/admin/combustiveis">Voltar para a lista</MudButton>
    }
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 600px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudTextField T="string" Label="Nome" @bind-Value="_nome" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" Label="Unidade de medida" @bind-Value="_unidadeMedida" Variant="Variant.Outlined" Class="mb-3" />
        <MudCheckBox T="bool" @bind-Value="_combustivelPrincipal" Label="É um combustível principal (não aparece no seletor de viagens)" Class="mb-3" />

        <MudSelect T="int?" Label="Combustível biogênico (opcional)" @bind-Value="_codigoCombustivelBiogenico"
                   Variant="Variant.Outlined" Clearable="true" Class="mb-3">
            @foreach (var combustivel in _combustiveis!.Where(c => c.Codigo != Codigo))
            {
                <MudSelectItem T="int?" Value="@combustivel.Codigo">@combustivel.Nome</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int?" Label="Combustível fóssil (opcional)" @bind-Value="_codigoCombustivelFossil"
                   Variant="Variant.Outlined" Clearable="true" Class="mb-3">
            @foreach (var combustivel in _combustiveis!.Where(c => c.Codigo != Codigo))
            {
                <MudSelectItem T="int?" Value="@combustivel.Codigo">@combustivel.Nome</MudSelectItem>
            }
        </MudSelect>

        <div class="d-flex gap-2 mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/admin/combustiveis" Disabled="@_isSaving">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private List<CombustivelDto>? _combustiveis;
    private bool _loaded;
    private bool _notFound;
    private string _nome = string.Empty;
    private string _unidadeMedida = string.Empty;
    private bool _combustivelPrincipal;
    private int? _codigoCombustivelBiogenico;
    private int? _codigoCombustivelFossil;
    private string? _errorMessage;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _combustiveis = await Mediator.Send(new GetTodosCombustiveisQuery());

        var combustivel = await Mediator.Send(new GetCombustivelByIdQuery(Codigo));
        if (combustivel is null)
        {
            _notFound = true;
            return;
        }

        _nome = combustivel.Nome;
        _unidadeMedida = combustivel.UnidadeMedida;
        _combustivelPrincipal = combustivel.CombustivelPrincipal;
        _codigoCombustivelBiogenico = combustivel.CodigoCombustivelBiogenico;
        _codigoCombustivelFossil = combustivel.CodigoCombustivelFossil;
        _loaded = true;
    }

    private async Task HandleSaveAsync()
    {
        _isSaving = true;
        try
        {
            await Mediator.Send(new UpdateCombustivelCommand(
                Codigo, _nome, _unidadeMedida, _combustivelPrincipal, _codigoCombustivelBiogenico, _codigoCombustivelFossil));
            Snackbar.Add("Combustível atualizado com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/admin/combustiveis");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _loaded = false;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar o combustível agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
