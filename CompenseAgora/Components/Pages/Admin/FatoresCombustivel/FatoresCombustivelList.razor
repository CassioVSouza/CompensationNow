@page "/admin/fatores-combustivel"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Features.FatoresCombustivel
@using CompenseAgora.Features.FatoresCombustivel.Queries.GetFatoresCombustivel
@using MediatR
@inject IMediator Mediator

<PageTitle>Fatores do combustível</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Fatores do combustível</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/fatores-combustivel/novo">
        Novo fator
    </MudButton>
</div>

@if (_fatores is null)
{
    <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando fatores…</span>
    </div>
}
else if (_fatores.Count == 0)
{
    <MudPaper Class="pa-6 d-flex flex-column align-items-center text-center" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Nenhum fator cadastrado ainda</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/fatores-combustivel/novo">
            Novo fator
        </MudButton>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudTable Items="_fatores" Hover="true" Striped="true" Dense="false">
            <HeaderContent>
                <MudTh>Combustível</MudTh>
                <MudTh>Ano</MudTh>
                <MudTh>PCI</MudTh>
                <MudTh>Densidade</MudTh>
                <MudTh>CO2</MudTh>
                <MudTh>CH4</MudTh>
                <MudTh>N2O</MudTh>
                <MudTh Style="width: 1%;"></MudTh>
            </HeaderContent>
            <RowTemplate Context="fator">
                <MudTd DataLabel="Combustível">@fator.NomeCombustivel</MudTd>
                <MudTd DataLabel="Ano">@fator.Ano</MudTd>
                <MudTd DataLabel="PCI">@fator.PoderCalorificoInferior.ToString("N4")</MudTd>
                <MudTd DataLabel="Densidade">@fator.Densidade.ToString("N4")</MudTd>
                <MudTd DataLabel="CO2">@fator.CO2.ToString("N4")</MudTd>
                <MudTd DataLabel="CH4">@fator.CH4.ToString("N4")</MudTd>
                <MudTd DataLabel="N2O">@fator.N2O.ToString("N4")</MudTd>
                <MudTd DataLabel="Ações" Class="text-nowrap">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                   Href="@($"/admin/fatores-combustivel/{fator.Codigo}/editar")" title="Editar" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   Href="@($"/admin/fatores-combustivel/{fator.Codigo}/excluir")" title="Excluir" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Linhas por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<FatorCombustivelDto>? _fatores;

    protected override async Task OnInitializedAsync()
    {
        _fatores = await Mediator.Send(new GetFatoresCombustivelQuery());
    }
}
