@page "/admin/fatores-combustivel/novo"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Features.Combustiveis
@using CompenseAgora.Features.Combustiveis.Queries.GetTodosCombustiveis
@using CompenseAgora.Features.FatoresCombustivel.Commands.CreateFatorCombustivel
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Novo fator do combustível</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Novo fator do combustível</MudText>

@if (_combustiveis is null)
{
    <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando…</span>
    </div>
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 640px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudSelect T="int" Label="Combustível" @bind-Value="_codigoCombustivel" Variant="Variant.Outlined"
                   Placeholder="Selecione um combustível..." Class="mb-3">
            @foreach (var combustivel in _combustiveis)
            {
                <MudSelectItem T="int" Value="@combustivel.Codigo">@combustivel.Nome</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" Culture="@CulturaBrasileira.PtBr" Label="Ano" @bind-Value="_ano" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Poder calorífico inferior" @bind-Value="_poderCalorificoInferior"
                          Variant="Variant.Outlined" Min="0" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Densidade" @bind-Value="_densidade" Variant="Variant.Outlined" Min="0" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Fator CO2" @bind-Value="_co2" Variant="Variant.Outlined" Min="0" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Fator CH4" @bind-Value="_ch4" Variant="Variant.Outlined" Min="0" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Fator N2O" @bind-Value="_n2o" Variant="Variant.Outlined" Min="0" Class="mb-3" />

        <div class="d-flex gap-2 mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/admin/fatores-combustivel" Disabled="@_isSaving">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    private List<CombustivelDto>? _combustiveis;
    private int _codigoCombustivel;
    private int _ano = DateTime.Now.Year;
    private decimal _poderCalorificoInferior;
    private decimal _densidade;
    private decimal _co2;
    private decimal _ch4;
    private decimal _n2o;
    private string? _errorMessage;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _combustiveis = await Mediator.Send(new GetTodosCombustiveisQuery());
    }

    private async Task HandleSaveAsync()
    {
        _isSaving = true;
        try
        {
            await Mediator.Send(new CreateFatorCombustivelCommand(
                _codigoCombustivel, _ano, _poderCalorificoInferior, _densidade, _co2, _ch4, _n2o));
            Snackbar.Add("Fator cadastrado com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/admin/fatores-combustivel");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar o fator agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
