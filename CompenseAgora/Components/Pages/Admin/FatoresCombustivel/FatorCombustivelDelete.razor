@page "/admin/fatores-combustivel/{Codigo:int}/excluir"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.FatoresCombustivel
@using CompenseAgora.Features.FatoresCombustivel.Commands.DeleteFatorCombustivel
@using CompenseAgora.Features.FatoresCombustivel.Queries.GetFatorCombustivelById
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Excluir fator do combustível</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Excluir fator do combustível</MudText>

@if (_fator is null)
{
    @if (!_notFound)
    {
        <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <span>Carregando fator…</span>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Este fator não foi encontrado. Ele pode já ter sido excluído.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" Href="/admin/fatores-combustivel">Voltar para a lista</MudButton>
    }
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 640px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            Tem certeza de que deseja excluir o fator de <strong>@_fator.NomeCombustivel (@_fator.Ano)</strong>?
            Esta ação não pode ser desfeita.
        </MudAlert>

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="HandleDeleteAsync" Disabled="@_isDeleting">
                @if (_isDeleting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Excluir fator
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/admin/fatores-combustivel" Disabled="@_isDeleting">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private FatorCombustivelDto? _fator;
    private bool _notFound;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _fator = await Mediator.Send(new GetFatorCombustivelByIdQuery(Codigo));
        if (_fator is null)
        {
            _notFound = true;
        }
    }

    private async Task HandleDeleteAsync()
    {
        _isDeleting = true;
        try
        {
            await Mediator.Send(new DeleteFatorCombustivelCommand(Codigo));
            Snackbar.Add("Fator excluído com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/admin/fatores-combustivel");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _fator = null;
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível excluir o fator agora. Tente novamente em instantes.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
