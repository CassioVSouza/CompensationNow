@page "/admin/consumos-medio-frota/{Codigo:int}/editar"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Entities
@using CompenseAgora.Features.ConsumosMedioFrota.Commands.UpdateConsumoMedioFrota
@using CompenseAgora.Features.ConsumosMedioFrota.Queries.GetConsumoMedioFrotaById
@using CompenseAgora.Features.Frotas
@using CompenseAgora.Features.Frotas.Queries.GetFrotas
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Editar consumo médio da frota</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Editar consumo médio da frota</MudText>

@if (!_loaded)
{
    @if (!_notFound)
    {
        <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <span>Carregando…</span>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Este consumo médio não foi encontrado. Ele pode já ter sido excluído.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" Href="/admin/consumos-medio-frota">Voltar para a lista</MudButton>
    }
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 600px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudSelect T="int" Label="Frota" @bind-Value="_codigoFrota" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var frota in _frotas!)
            {
                <MudSelectItem T="int" Value="@frota.Codigo">@frota.Nome</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" Culture="@CulturaBrasileira.PtBr" Label="Ano" @bind-Value="_ano" Variant="Variant.Outlined" Class="mb-3" />
        <MudCheckBox T="bool" @bind-Value="_paraTodos" Label="Vale para todos os anos" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="Consumo médio" @bind-Value="_consumo" Variant="Variant.Outlined" Min="0" Class="mb-3" />
        <MudTextField T="string" Label="Unidade de medida" @bind-Value="_unidadeMedida" Variant="Variant.Outlined" Class="mb-3" />

        <div class="d-flex gap-2 mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/admin/consumos-medio-frota" Disabled="@_isSaving">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private List<FrotaDto>? _frotas;
    private bool _loaded;
    private bool _notFound;
    private int _codigoFrota;
    private int _ano;
    private bool _paraTodos;
    private decimal _consumo;
    private string _unidadeMedida = string.Empty;
    private string? _errorMessage;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _frotas = await Mediator.Send(new GetFrotasQuery());

        var consumo = await Mediator.Send(new GetConsumoMedioFrotaByIdQuery(Codigo));
        if (consumo is null)
        {
            _notFound = true;
            return;
        }

        _codigoFrota = consumo.CodigoFrota;
        _ano = consumo.Ano;
        _paraTodos = consumo.ParaTodos;
        _consumo = consumo.Consumo;
        _unidadeMedida = consumo.UnidadeMedida;
        _loaded = true;
    }

    private async Task HandleSaveAsync()
    {
        _isSaving = true;
        try
        {
            await Mediator.Send(new UpdateConsumoMedioFrotaCommand(Codigo, _codigoFrota, _paraTodos, _ano, _consumo, _unidadeMedida));
            Snackbar.Add("Consumo médio atualizado com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/admin/consumos-medio-frota");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _loaded = false;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar o consumo médio agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
