@page "/admin/gases-efeito-estufa/{Codigo:int}/editar"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.GasesEfeitoEstufa.Commands.UpdateGasEfeitoEstufa
@using CompenseAgora.Features.GasesEfeitoEstufa.Queries.GetGasEfeitoEstufaById
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Editar gás de efeito estufa</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Editar gás de efeito estufa</MudText>

@if (!_loaded)
{
    @if (!_notFound)
    {
        <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <span>Carregando gás…</span>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Este gás não foi encontrado. Ele pode já ter sido excluído.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" Href="/admin/gases-efeito-estufa">Voltar para a lista</MudButton>
    }
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 600px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudTextField T="string" Label="Nome" @bind-Value="_nome" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" Label="Família" @bind-Value="_familia" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="GWP (potencial de aquecimento global)" @bind-Value="_gwp"
                          Variant="Variant.Outlined" Min="0" Class="mb-3" />

        <div class="d-flex gap-2 mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/admin/gases-efeito-estufa" Disabled="@_isSaving">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private bool _loaded;
    private bool _notFound;
    private string _nome = string.Empty;
    private string _familia = string.Empty;
    private decimal _gwp;
    private string? _errorMessage;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        var gas = await Mediator.Send(new GetGasEfeitoEstufaByIdQuery(Codigo));
        if (gas is null)
        {
            _notFound = true;
            return;
        }

        _nome = gas.Nome;
        _familia = gas.Familia;
        _gwp = gas.GWP;
        _loaded = true;
    }

    private async Task HandleSaveAsync()
    {
        _isSaving = true;
        try
        {
            await Mediator.Send(new UpdateGasEfeitoEstufaCommand(Codigo, _nome, _familia, _gwp));
            Snackbar.Add("Gás atualizado com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/admin/gases-efeito-estufa");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _loaded = false;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar o gás agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
