@page "/admin/gases-efeito-estufa/{Codigo:int}/excluir"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.GasesEfeitoEstufa
@using CompenseAgora.Features.GasesEfeitoEstufa.Commands.DeleteGasEfeitoEstufa
@using CompenseAgora.Features.GasesEfeitoEstufa.Queries.GetGasEfeitoEstufaById
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Excluir gás de efeito estufa</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Excluir gás de efeito estufa</MudText>

@if (_gas is null)
{
    @if (!_notFound)
    {
        <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <span>Carregando gás…</span>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Este gás não foi encontrado. Ele pode já ter sido excluído.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" Href="/admin/gases-efeito-estufa">Voltar para a lista</MudButton>
    }
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 600px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            Tem certeza de que deseja excluir <strong>@_gas.Nome</strong>? Esta ação não pode ser desfeita.
        </MudAlert>

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="HandleDeleteAsync" Disabled="@_isDeleting">
                @if (_isDeleting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Excluir gás
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/admin/gases-efeito-estufa" Disabled="@_isDeleting">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private GasEfeitoEstufaDto? _gas;
    private bool _notFound;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _gas = await Mediator.Send(new GetGasEfeitoEstufaByIdQuery(Codigo));
        if (_gas is null)
        {
            _notFound = true;
        }
    }

    private async Task HandleDeleteAsync()
    {
        _isDeleting = true;
        try
        {
            await Mediator.Send(new DeleteGasEfeitoEstufaCommand(Codigo));
            Snackbar.Add("Gás excluído com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/admin/gases-efeito-estufa");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _gas = null;
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível excluir o gás agora. Ele pode estar em uso por outros registros.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
