@page "/admin/fatores-energia/{Codigo:int}/editar"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Entities
@using CompenseAgora.Features.FatoresEnergia.Commands.UpdateFatorEnergia
@using CompenseAgora.Features.FatoresEnergia.Queries.GetFatorEnergiaById
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Editar fator de energia</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Editar fator de energia</MudText>

@if (!_loaded)
{
    @if (!_notFound)
    {
        <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <span>Carregando…</span>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Este fator não foi encontrado. Ele pode já ter sido excluído.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" Href="/admin/fatores-energia">Voltar para a lista</MudButton>
    }
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 600px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudNumericField T="int" Culture="@CulturaBrasileira.PtBr" Label="Mês" @bind-Value="_mes" Variant="Variant.Outlined" Min="1" Max="12" Class="mb-3" />
        <MudNumericField T="int" Culture="@CulturaBrasileira.PtBr" Label="Ano" @bind-Value="_ano" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="decimal" Culture="@CulturaBrasileira.PtBr" Label="FeSin (kg CO2e/kWh)" @bind-Value="_feSin" Variant="Variant.Outlined" Min="0" Class="mb-3" />

        <div class="d-flex gap-2 mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/admin/fatores-energia" Disabled="@_isSaving">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private bool _loaded;
    private bool _notFound;
    private int _mes;
    private int _ano;
    private decimal _feSin;
    private string? _errorMessage;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        var fator = await Mediator.Send(new GetFatorEnergiaByIdQuery(Codigo));
        if (fator is null)
        {
            _notFound = true;
            return;
        }

        _mes = fator.Mes;
        _ano = fator.Ano;
        _feSin = fator.FeSin;
        _loaded = true;
    }

    private async Task HandleSaveAsync()
    {
        _isSaving = true;
        try
        {
            await Mediator.Send(new UpdateFatorEnergiaCommand(Codigo, _mes, _ano, _feSin));
            Snackbar.Add("Fator atualizado com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/admin/fatores-energia");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _loaded = false;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar o fator agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
