@page "/admin/frotas"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Features.Frotas
@using CompenseAgora.Features.Frotas.Queries.GetFrotas
@using MediatR
@inject IMediator Mediator

<PageTitle>Veículos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Veículos</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/frotas/nova">
        Novo veículo
    </MudButton>
</div>

@if (_frotas is null)
{
    <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando veículos…</span>
    </div>
}
else if (_frotas.Count == 0)
{
    <MudPaper Class="pa-6 d-flex flex-column align-items-center text-center" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Nenhum veículo cadastrado ainda</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/frotas/nova">
            Novo veículo
        </MudButton>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudTable Items="_frotas" Hover="true" Striped="true" Dense="false">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Combustível primário</MudTh>
                <MudTh>Biogênico</MudTh>
                <MudTh>Fóssil</MudTh>
                <MudTh Style="width: 1%;"></MudTh>
            </HeaderContent>
            <RowTemplate Context="frota">
                <MudTd DataLabel="Nome">@frota.Nome</MudTd>
                <MudTd DataLabel="Combustível primário">@frota.NomeCombustivelPrimario</MudTd>
                <MudTd DataLabel="Biogênico">@(frota.NomeCombustivelBiogenico ?? "-")</MudTd>
                <MudTd DataLabel="Fóssil">@(frota.NomeCombustivelFossil ?? "-")</MudTd>
                <MudTd DataLabel="Ações" Class="text-nowrap">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                   Href="@($"/admin/frotas/{frota.Codigo}/editar")" title="Editar" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   Href="@($"/admin/frotas/{frota.Codigo}/excluir")" title="Excluir" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Linhas por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<FrotaDto>? _frotas;

    protected override async Task OnInitializedAsync()
    {
        _frotas = await Mediator.Send(new GetFrotasQuery());
    }
}
