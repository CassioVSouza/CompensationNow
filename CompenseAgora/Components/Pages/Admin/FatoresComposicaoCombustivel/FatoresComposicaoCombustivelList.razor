@page "/admin/fatores-composicao-combustivel"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CompenseAgora.Features.FatoresComposicaoCombustivel
@using CompenseAgora.Features.FatoresComposicaoCombustivel.Queries.GetFatoresComposicaoCombustivel
@using MediatR
@inject IMediator Mediator

<PageTitle>Composição do combustível</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Composição do combustível</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/fatores-composicao-combustivel/novo">
        Novo percentual
    </MudButton>
</div>

@if (_fatores is null)
{
    <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando…</span>
    </div>
}
else if (_fatores.Count == 0)
{
    <MudPaper Class="pa-6 d-flex flex-column align-items-center text-center" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-1">Nenhum percentual cadastrado ainda</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/fatores-composicao-combustivel/novo">
            Novo percentual
        </MudButton>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudTable Items="_fatores" Hover="true" Striped="true" Dense="false">
            <HeaderContent>
                <MudTh>Mês</MudTh>
                <MudTh>Ano</MudTh>
                <MudTh>% Etanol</MudTh>
                <MudTh>% Biodiesel</MudTh>
                <MudTh Style="width: 1%;"></MudTh>
            </HeaderContent>
            <RowTemplate Context="fator">
                <MudTd DataLabel="Mês">@fator.Mes</MudTd>
                <MudTd DataLabel="Ano">@fator.Ano</MudTd>
                <MudTd DataLabel="% Etanol">@fator.PercentualEtanol.ToString("N2")</MudTd>
                <MudTd DataLabel="% Biodiesel">@fator.PercentualBiodiesel.ToString("N2")</MudTd>
                <MudTd DataLabel="Ações" Class="text-nowrap">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                   Href="@($"/admin/fatores-composicao-combustivel/{fator.Codigo}/editar")" title="Editar" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   Href="@($"/admin/fatores-composicao-combustivel/{fator.Codigo}/excluir")" title="Excluir" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Linhas por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<FatorComposicaoCombustivelDto>? _fatores;

    protected override async Task OnInitializedAsync()
    {
        _fatores = await Mediator.Send(new GetFatoresComposicaoCombustivelQuery());
    }
}
