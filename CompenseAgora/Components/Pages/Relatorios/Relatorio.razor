@page "/relatorio"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using CompenseAgora.Common
@using CompenseAgora.Features.Common
@using CompenseAgora.Features.Dashboard
@using CompenseAgora.Features.Dashboard.Queries.GetDashboard
@using CompenseAgora.Features.Viagens
@using CompenseAgora.Features.Viagens.Queries.GetViagens
@using CompenseAgora.Features.Energias
@using CompenseAgora.Features.Energias.Queries.GetEnergias
@using CompenseAgora.Features.Compensacoes
@using CompenseAgora.Features.Compensacoes.Queries.GetCompensacoes
@using MediatR
@inject IMediator Mediator
@inject IJSRuntime JsRuntime

<PageTitle>Relatório de emissões</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3 no-print">
    <div>
        <h1 class="mb-1">Relatório de emissões</h1>
        <p class="text-muted mb-0">Resumo completo das suas emissões de CO2e registradas na plataforma.</p>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
               Disabled="@(_dashboard is null)" OnClick="BaixarRelatorioAsync">
        Baixar relatório
    </MudButton>
</div>

<div class="no-print">
    <FiltroPeriodo OnFiltroAplicado="AoAplicarFiltroAsync" />
</div>

@if (_carregando || _dashboard is null)
{
    <div class="d-flex align-items-center gap-3 py-5 no-print" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando seu relatório…</span>
    </div>
}
else
{
    <div class="report-content">
        <div class="report-header mb-4">
            <MudText Typo="Typo.h5" Class="mb-1">@_nomeCompleto</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Período: @_periodoDescricao · Gerado em @DateTime.Now.ToString("dd/MM/yyyy 'às' HH:mm", CultureInfo.GetCultureInfo("pt-BR"))
            </MudText>
        </div>

        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Sobre este relatório</MudText>
            <MudText Typo="Typo.body2">
                Este relatório consolida as emissões de dióxido de carbono equivalente (CO2e) registradas por você
                na Compense Agora, com base nas suas viagens e no seu consumo de energia. Os valores são calculados
                a partir dos fatores de emissão cadastrados para cada combustível e fonte de energia, e são
                expressos em toneladas de CO2 equivalente (t CO2e). Use estes números para acompanhar sua
                pegada de carbono ao longo do tempo e identificar oportunidades de redução ou compensação.
            </MudText>
        </MudPaper>

        @if (_dashboard.TotalEmissao == 0 && _dashboard.TotalCompensacao == 0)
        {
            <MudPaper Class="pa-6 d-flex flex-column align-items-center text-center" Elevation="0" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="mb-1">Nenhuma emissão registrada ainda</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    Adicione uma viagem ou um registro de energia para gerar seu relatório de emissões.
                </MudText>
            </MudPaper>
        }
        else
        {
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-4" Elevation="1" Style="border-left: 4px solid #0b0b0b;">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Emissão total</MudText>
                        <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalEmissao)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-4" Elevation="1" Style="@($"border-left: 4px solid {CompenseAgoraTheme.ChartSeriesColors[0]};")">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Emissão de viagens</MudText>
                        <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalViagem)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-4" Elevation="1" Style="@($"border-left: 4px solid {CompenseAgoraTheme.ChartSeriesColors[1]};")">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Emissão de energia</MudText>
                        <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalEnergia)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-4" Elevation="1" Style="@($"border-left: 4px solid {CompenseAgoraTheme.CompensacaoSeriesColors[1]};")">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Compensação total</MudText>
                        <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalCompensacao)</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-4">
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Emitido vs. compensado, últimos 12 meses</MudText>
                        <MudChart ChartType="ChartType.Line" ChartSeries="@_emitidoCompensadoSeries" ChartLabels="@_monthLabels"
                                  ChartOptions="@_emitidoCompensadoOptions" Width="100%" Height="300px" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Emissão total, últimos 12 meses</MudText>
                        <MudChart ChartType="ChartType.Line" ChartSeries="@_totalSeries" ChartLabels="@_monthLabels"
                                  ChartOptions="@_lineOptions" Width="100%" Height="300px" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Viagens vs. energia</MudText>
                        <MudChart ChartType="ChartType.StackedBar" ChartSeries="@_splitSeries" ChartLabels="@_monthLabels"
                                  ChartOptions="@_barOptions" Width="100%" Height="300px" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Emissão de viagens, últimos 12 meses</MudText>
                        <MudChart ChartType="ChartType.Line" ChartSeries="@_viagemSeries" ChartLabels="@_monthLabels"
                                  ChartOptions="@_viagemLineOptions" Width="100%" Height="300px" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Emissão de energia, últimos 12 meses</MudText>
                        <MudChart ChartType="ChartType.Line" ChartSeries="@_energiaSeries" ChartLabels="@_monthLabels"
                                  ChartOptions="@_energiaLineOptions" Width="100%" Height="300px" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.h6" Class="mb-2">Viagens registradas</MudText>
            @if (_viagens.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Nenhuma viagem registrada.</MudText>
            }
            else
            {
                <MudTable Items="@_viagens" Dense="true" Hover="true" Class="mb-4" Elevation="1">
                    <HeaderContent>
                        <MudTh>Data</MudTh>
                        <MudTh>Veículo</MudTh>
                        <MudTh>Combustível</MudTh>
                        <MudTh>Distância (km)</MudTh>
                        <MudTh>Consumo</MudTh>
                        <MudTh>Emissão (t CO2e)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Data">@context.DataReferencia.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Veículo">@context.FrotaNome</MudTd>
                        <MudTd DataLabel="Combustível">@(context.CombustivelNome ?? "—")</MudTd>
                        <MudTd DataLabel="Distância (km)">@context.DistanciaKM.ToString("N2")</MudTd>
                        <MudTd DataLabel="Consumo">@context.Consumo.ToString("N2")</MudTd>
                        <MudTd DataLabel="Emissão (t CO2e)">@FormatadorEmissao.ParaToneladas(context.EmissaoCO2).ToString("N3")</MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <MudText Typo="Typo.h6" Class="mb-2">Consumo de energia registrado</MudText>
            @if (_energias.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhum registro de energia.</MudText>
            }
            else
            {
                <MudTable Items="@_energias" Dense="true" Hover="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Data</MudTh>
                        <MudTh>Quantidade</MudTh>
                        <MudTh>Emissão (t CO2e)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Data">@context.DataReferencia.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Quantidade">@context.Quantidade.ToString("N2")</MudTd>
                        <MudTd DataLabel="Emissão (t CO2e)">@FormatadorEmissao.ParaToneladas(context.EmissaoCO2).ToString("N3")</MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <MudText Typo="Typo.h6" Class="mb-2">Compensações registradas</MudText>
            @if (_compensacoes.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhuma compensação registrada.</MudText>
            }
            else
            {
                <MudTable Items="@_compensacoes" Dense="true" Hover="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Data</MudTh>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Quantidade compensada (t CO2e)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Data">@context.DataReferencia.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Tipo">@context.TipoCompensacao</MudTd>
                        <MudTd DataLabel="Quantidade compensada (t CO2e)">@FormatadorEmissao.ParaToneladas(context.QuantidadeCompensada).ToString("N3")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </div>
}

@code {
    private DashboardDto? _dashboard;
    private bool _carregando = true;
    private int _codigoPessoa;
    private List<ViagemDto> _viagens = [];
    private List<EnergiaDto> _energias = [];
    private List<CompensacaoDto> _compensacoes = [];
    private string _nomeCompleto = string.Empty;
    private string _periodoDescricao = string.Empty;
    private string[] _monthLabels = [];
    private List<ChartSeries<double>> _totalSeries = [];
    private List<ChartSeries<double>> _splitSeries = [];
    private List<ChartSeries<double>> _viagemSeries = [];
    private List<ChartSeries<double>> _energiaSeries = [];
    private List<ChartSeries<double>> _emitidoCompensadoSeries = [];
    private LineChartOptions _lineOptions = new();
    private LineChartOptions _viagemLineOptions = new();
    private LineChartOptions _energiaLineOptions = new();
    private LineChartOptions _emitidoCompensadoOptions = new();
    private StackedBarChartOptions _barOptions = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        _codigoPessoa = int.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);
        var nome = authState.User.FindFirstValue(ClaimTypes.GivenName);
        var sobrenome = authState.User.FindFirstValue(ClaimTypes.Surname);
        _nomeCompleto = $"{nome} {sobrenome}".Trim();

        await CarregarDadosAsync();
    }

    private async Task AoAplicarFiltroAsync((DateOnly Inicio, DateOnly Fim) intervalo)
    {
        await CarregarDadosAsync(intervalo.Inicio, intervalo.Fim);
    }

    private async Task CarregarDadosAsync(DateOnly? inicio = null, DateOnly? fim = null)
    {
        _carregando = true;
        StateHasChanged();

        _dashboard = await Mediator.Send(new GetDashboardQuery(_codigoPessoa, inicio, fim));
        _viagens = await Mediator.Send(new GetViagensQuery(_codigoPessoa, inicio, fim));
        _energias = await Mediator.Send(new GetEnergiasQuery(_codigoPessoa, inicio, fim));
        _compensacoes = await Mediator.Send(new GetCompensacoesQuery(_codigoPessoa, inicio, fim));

        // Describe the period from the resolved filter range itself, not by reverse-engineering it
        // from the returned data — when no filter has been applied yet, mirror the dashboard's own
        // default (last 12 months) so the description matches what's actually shown.
        var (periodoInicio, periodoFim) = inicio is not null && fim is not null
            ? (inicio.Value, fim.Value)
            : FiltroPeriodoHelper.CalcularIntervalo(TipoPeriodoFiltro.Ultimos12Meses, null, null, null, null);

        _periodoDescricao =
            $"{periodoInicio.ToString("dd/MM/yyyy", CulturaBrasileira.PtBr)} a {periodoFim.ToString("dd/MM/yyyy", CulturaBrasileira.PtBr)}";

        _monthLabels = _dashboard.MonthlyEmissions
            .Select(m => new DateTime(m.Year, m.Month, 1).ToString("MMM/yy", CultureInfo.InvariantCulture))
            .ToArray();

        _totalSeries =
        [
            new ChartSeries<double>
            {
                Name = "Emissão total",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.Total)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _splitSeries =
        [
            new ChartSeries<double>
            {
                Name = "Viagens",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.ViagemEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            },
            new ChartSeries<double>
            {
                Name = "Energia",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.EnergiaEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _viagemSeries =
        [
            new ChartSeries<double>
            {
                Name = "Viagens",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.ViagemEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _energiaSeries =
        [
            new ChartSeries<double>
            {
                Name = "Energia",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.EnergiaEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _emitidoCompensadoSeries =
        [
            new ChartSeries<double>
            {
                Name = "Emitido",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.Total)).ToArray(),
                TooltipYValueFormat = "N3",
            },
            new ChartSeries<double>
            {
                Name = "Compensado",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.Compensacao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        var maiorTotal = _totalSeries[0].Data.DefaultIfEmpty(0).Max();
        var maiorViagem = _viagemSeries[0].Data.DefaultIfEmpty(0).Max();
        var maiorEnergia = _energiaSeries[0].Data.DefaultIfEmpty(0).Max();
        var maiorEmitidoCompensado = _emitidoCompensadoSeries.SelectMany(s => s.Data).DefaultIfEmpty(0).Max();

        _lineOptions = new LineChartOptions
        {
            ChartPalette = [CompenseAgoraTheme.TrendColor],
            ShowLegend = false,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorTotal),
            XAxisLabelRotation = -45,
        };

        _viagemLineOptions = new LineChartOptions
        {
            ChartPalette = [CompenseAgoraTheme.ChartSeriesColors[0]],
            ShowLegend = false,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorViagem),
            XAxisLabelRotation = -45,
        };

        _energiaLineOptions = new LineChartOptions
        {
            ChartPalette = [CompenseAgoraTheme.ChartSeriesColors[1]],
            ShowLegend = false,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorEnergia),
            XAxisLabelRotation = -45,
        };

        _barOptions = new StackedBarChartOptions
        {
            ChartPalette = CompenseAgoraTheme.ChartSeriesColors,
            ShowLegend = true,
            ShowValues = false,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorTotal),
            XAxisLabelRotation = -45,
        };

        _emitidoCompensadoOptions = new LineChartOptions
        {
            ChartPalette = CompenseAgoraTheme.CompensacaoSeriesColors,
            ShowLegend = true,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorEmitidoCompensado),
            XAxisLabelRotation = -45,
        };

        _carregando = false;
    }

    private async Task BaixarRelatorioAsync()
    {
        await JsRuntime.InvokeVoidAsync("window.print");
    }
}
