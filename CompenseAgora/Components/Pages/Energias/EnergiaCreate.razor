@page "/energias/nova"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using CompenseAgora.Features.Energias.Commands.CreateEnergia
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Novo registro de energia</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Novo registro de energia</MudText>

<MudPaper Class="pa-4" Elevation="1" Style="max-width: 640px;">
    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudDatePicker Label="Data de referência" @bind-Date="_dataReferencia" @bind-Date:after="ClearError"
                           Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"
                           HelperText="Data a que este consumo de energia se refere." />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="decimal" Label="Quantidade (kWh)" @bind-Value="_input.Quantidade" @bind-Value:after="ClearError"
                              Variant="Variant.Outlined" Min="0"
                              HelperText="Consumo de energia elétrica no período, em quilowatt-hora." />
        </MudItem>
    </MudGrid>

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSaveAsync" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Salvar
        </MudButton>
        <MudButton Variant="Variant.Text" Href="/energias" Disabled="@_isSaving">Cancelar</MudButton>
    </div>
</MudPaper>

@code {
    private EnergiaInputModel _input = new();
    private DateTime? _dataReferencia = DateTime.Now;
    private string? _errorMessage;
    private bool _isSaving;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private void ClearError()
    {
        _input.DataReferencia = DateOnly.FromDateTime(_dataReferencia ?? DateTime.Now);
        _errorMessage = null;
    }

    private async Task HandleSaveAsync()
    {
        _input.DataReferencia = DateOnly.FromDateTime(_dataReferencia ?? DateTime.Now);

        if (_input.Quantidade <= 0)
        {
            _errorMessage = "Informe a quantidade de energia.";
            return;
        }

        var authState = await AuthenticationStateTask!;
        var codigoPessoa = int.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        _isSaving = true;
        try
        {
            await Mediator.Send(new CreateEnergiaCommand(codigoPessoa, _input.DataReferencia, _input.Quantidade));
            Snackbar.Add("Registro de energia criado com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/energias");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível salvar o registro agora. Tente novamente em instantes.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private class EnergiaInputModel
    {
        public DateOnly DataReferencia { get; set; } = DateOnly.FromDateTime(DateTime.Now);
        public decimal Quantidade { get; set; }
    }
}
