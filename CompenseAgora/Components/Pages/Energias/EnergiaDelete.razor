@page "/energias/{Codigo:int}/excluir"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using CompenseAgora.Common.Exceptions
@using CompenseAgora.Features.Energias.Commands.DeleteEnergia
@using CompenseAgora.Features.Energias.Queries.GetEnergiaById
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Excluir registro de energia</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Excluir registro de energia</MudText>

@if (_energia is null)
{
    @if (!_notFound)
    {
        <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <span>Carregando registro de energia…</span>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Este registro de energia não foi encontrado. Ele pode já ter sido excluído.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" Href="/energias">Voltar para a lista</MudButton>
    }
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width: 640px;">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            Tem certeza de que deseja excluir este registro de energia? Esta ação não pode ser desfeita.
        </MudAlert>

        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Data de referência</MudText></td>
                    <td><MudText Typo="Typo.body1">@_energia.DataReferencia.ToString("dd/MM/yyyy")</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Quantidade</MudText></td>
                    <td><MudText Typo="Typo.body1">@_energia.Quantidade.ToString("N2") kWh</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Emissão de CO2</MudText></td>
                    <td><MudText Typo="Typo.body1">@_energia.EmissaoCO2.ToString("N2") kg</MudText></td>
                </tr>
            </tbody>
        </MudSimpleTable>

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="HandleDeleteAsync" Disabled="@_isDeleting">
                @if (_isDeleting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Excluir registro
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/energias" Disabled="@_isDeleting">Cancelar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Codigo { get; set; }

    private Features.Energias.EnergiaDto? _energia;
    private bool _notFound;
    private bool _isDeleting;
    private string? _errorMessage;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var codigoPessoa = int.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        var energia = await Mediator.Send(new GetEnergiaByIdQuery(Codigo));
        if (energia is null || energia.CodigoPessoa != codigoPessoa)
        {
            _notFound = true;
            return;
        }

        _energia = energia;
    }

    private async Task HandleDeleteAsync()
    {
        _isDeleting = true;
        try
        {
            await Mediator.Send(new DeleteEnergiaCommand(Codigo));
            Snackbar.Add("Registro de energia excluído com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/energias");
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _energia = null;
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível excluir o registro agora. Tente novamente em instantes.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
