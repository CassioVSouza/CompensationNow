@page "/"
@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using CompenseAgora.Common
@using CompenseAgora.Features.Dashboard
@using CompenseAgora.Features.Dashboard.Queries.GetDashboard
@using MediatR
@inject IMediator Mediator

<PageTitle>Painel</PageTitle>

<h1 class="mb-3">Painel</h1>

<FiltroPeriodo OnFiltroAplicado="AoAplicarFiltroAsync" />

@if (_carregando || _dashboard is null)
{
    <div class="d-flex align-items-center gap-3 py-5" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>Carregando seu painel…</span>
    </div>
}
else if (_dashboard.TotalEmissao == 0 && _dashboard.TotalCompensacao == 0)
{
    <MudPaper Class="pa-6 d-flex flex-column align-items-center text-center" Elevation="0" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
        <MudText Typo="Typo.h6" Class="mb-1">Nenhuma emissão registrada ainda</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
            Adicione uma viagem ou um registro de energia para ver suas emissões neste gráfico.
        </MudText>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="/viagens/nova">Adicionar viagem</a>
            <a class="btn btn-outline-primary" href="/energias/nova">Adicionar registro de energia</a>
        </div>
    </MudPaper>
}
else
{
    <MudGrid Class="mb-2">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-left: 4px solid #0b0b0b;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Emissão total</MudText>
                <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalEmissao)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="@($"border-left: 4px solid {CompenseAgoraTheme.ChartSeriesColors[0]};")">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Emissão de viagens</MudText>
                <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalViagem)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="@($"border-left: 4px solid {CompenseAgoraTheme.ChartSeriesColors[1]};")">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Emissão de energia</MudText>
                <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalEnergia)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="@($"border-left: 4px solid {CompenseAgoraTheme.CompensacaoSeriesColors[1]};")">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Compensação total</MudText>
                <MudText Typo="Typo.h5">@FormatadorEmissao.FormatarToneladas(_dashboard.TotalCompensacao)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Emitido vs. compensado, últimos 12 meses</MudText>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_emitidoCompensadoSeries" ChartLabels="@_monthLabels"
                          ChartOptions="@_emitidoCompensadoOptions" Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Emissão total, últimos 12 meses</MudText>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_totalSeries" ChartLabels="@_monthLabels"
                          ChartOptions="@_lineOptions" Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Viagens vs. energia</MudText>
                <MudChart ChartType="ChartType.StackedBar" ChartSeries="@_splitSeries" ChartLabels="@_monthLabels"
                          ChartOptions="@_barOptions" Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Emissão de viagens, últimos 12 meses</MudText>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_viagemSeries" ChartLabels="@_monthLabels"
                          ChartOptions="@_viagemLineOptions" Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Emissão de energia, últimos 12 meses</MudText>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_energiaSeries" ChartLabels="@_monthLabels"
                          ChartOptions="@_energiaLineOptions" Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardDto? _dashboard;
    private bool _carregando = true;
    private int _codigoPessoa;
    private string[] _monthLabels = [];
    private List<ChartSeries<double>> _totalSeries = [];
    private List<ChartSeries<double>> _splitSeries = [];
    private List<ChartSeries<double>> _viagemSeries = [];
    private List<ChartSeries<double>> _energiaSeries = [];
    private List<ChartSeries<double>> _emitidoCompensadoSeries = [];
    private LineChartOptions _lineOptions = new();
    private LineChartOptions _viagemLineOptions = new();
    private LineChartOptions _energiaLineOptions = new();
    private LineChartOptions _emitidoCompensadoOptions = new();
    private StackedBarChartOptions _barOptions = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        _codigoPessoa = int.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        await CarregarDadosAsync();
    }

    private async Task AoAplicarFiltroAsync((DateOnly Inicio, DateOnly Fim) intervalo)
    {
        await CarregarDadosAsync(intervalo.Inicio, intervalo.Fim);
    }

    private async Task CarregarDadosAsync(DateOnly? inicio = null, DateOnly? fim = null)
    {
        _carregando = true;
        StateHasChanged();

        _dashboard = await Mediator.Send(new GetDashboardQuery(_codigoPessoa, inicio, fim));

        _monthLabels = _dashboard.MonthlyEmissions
            .Select(m => new DateTime(m.Year, m.Month, 1).ToString("MMM/yy", CultureInfo.InvariantCulture))
            .ToArray();

        _totalSeries =
        [
            new ChartSeries<double>
            {
                Name = "Emissão total",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.Total)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _splitSeries =
        [
            new ChartSeries<double>
            {
                Name = "Viagens",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.ViagemEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            },
            new ChartSeries<double>
            {
                Name = "Energia",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.EnergiaEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _viagemSeries =
        [
            new ChartSeries<double>
            {
                Name = "Viagens",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.ViagemEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _energiaSeries =
        [
            new ChartSeries<double>
            {
                Name = "Energia",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.EnergiaEmissao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        _emitidoCompensadoSeries =
        [
            new ChartSeries<double>
            {
                Name = "Emitido",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.Total)).ToArray(),
                TooltipYValueFormat = "N3",
            },
            new ChartSeries<double>
            {
                Name = "Compensado",
                Data = _dashboard.MonthlyEmissions.Select(m => (double)FormatadorEmissao.ParaToneladas(m.Compensacao)).ToArray(),
                TooltipYValueFormat = "N3",
            }
        ];

        var maiorTotal = _totalSeries[0].Data.DefaultIfEmpty(0).Max();
        var maiorViagem = _viagemSeries[0].Data.DefaultIfEmpty(0).Max();
        var maiorEnergia = _energiaSeries[0].Data.DefaultIfEmpty(0).Max();
        var maiorEmitidoCompensado = _emitidoCompensadoSeries.SelectMany(s => s.Data).DefaultIfEmpty(0).Max();

        _lineOptions = new LineChartOptions
        {
            ChartPalette = [CompenseAgoraTheme.TrendColor],
            ShowLegend = false,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorTotal),
            XAxisLabelRotation = -45,
        };

        _viagemLineOptions = new LineChartOptions
        {
            ChartPalette = [CompenseAgoraTheme.ChartSeriesColors[0]],
            ShowLegend = false,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorViagem),
            XAxisLabelRotation = -45,
        };

        _energiaLineOptions = new LineChartOptions
        {
            ChartPalette = [CompenseAgoraTheme.ChartSeriesColors[1]],
            ShowLegend = false,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorEnergia),
            XAxisLabelRotation = -45,
        };

        _barOptions = new StackedBarChartOptions
        {
            ChartPalette = CompenseAgoraTheme.ChartSeriesColors,
            ShowLegend = true,
            ShowValues = false,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorTotal),
            XAxisLabelRotation = -45,
        };

        _emitidoCompensadoOptions = new LineChartOptions
        {
            ChartPalette = CompenseAgoraTheme.CompensacaoSeriesColors,
            ShowLegend = true,
            ShowDataMarkers = true,
            YAxisRequireZeroPoint = true,
            YAxisTitle = "t CO2e",
            YAxisToStringFunc = v => v.ToString("N3"),
            YAxisTicks = EscalaEixoY.CalcularEspacamento(maiorEmitidoCompensado),
            XAxisLabelRotation = -45,
        };

        _carregando = false;
    }
}
